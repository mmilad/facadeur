{
  "version": 1,
  "id": "text-heading",
  "name": "Heading",
  "kind": "atom",
  "group": "content",
  "fields": [
    {
      "name": "text",
      "type": "text",
      "required": true,
      "default": ""
    }
  ],
  "previewData": {
    "fields": {
      "text": "Section title"
    }
  },
  "tokenInterface": {
    "reads": ["color.text.primary", "space.0", "type.title"]
  },
  "styles": {
    "declarations": {
      "color": "{color.text.primary}",
      "font": "{type.title}",
      "margin": "{space.0}"
    }
  },
  "root": {
    "id": "root",
    "name": "Heading",
    "type": "text",
    "tag": "h2",
    "layout": {
      "width": {
        "mode": "fill"
      },
      "height": {
        "mode": "hug"
      }
    },
    "bindings": [
      {
        "field": "text",
        "target": "text"
      }
    ]
  }
}
