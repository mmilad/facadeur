{
  "version": 1,
  "id": "text-body",
  "name": "Body text",
  "kind": "atom",
  "group": "content",
  "fields": [
    {
      "name": "text",
      "type": "text",
      "required": true,
      "default": ""
    }
  ],
  "previewData": {
    "fields": {
      "text": "Supporting copy that explains the idea in one or two short sentences."
    }
  },
  "tokenInterface": {
    "reads": ["color.text.secondary", "space.0", "type.body"]
  },
  "styles": {
    "declarations": {
      "color": "{color.text.secondary}",
      "font": "{type.body}",
      "margin": "{space.0}"
    }
  },
  "root": {
    "id": "root",
    "name": "Body",
    "type": "text",
    "tag": "p",
    "layout": {
      "width": {
        "mode": "fill"
      },
      "height": {
        "mode": "hug"
      }
    },
    "bindings": [
      {
        "field": "text",
        "target": "text"
      }
    ]
  }
}
