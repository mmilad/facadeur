      "data": {
        "fields": [
          {
            "name": "checked",
            "type": {
              "kind": "type",
              "type": "boolean"
            }
          }
        ]
      }
    }
  ],
  "root": {
    "id": "root",
    "name": "Checkbox",
    "type": "frame",
    "tag": "input",
    "attributes": {
      "type": "checkbox"
    },
    "bindings": [
      {
        "field": "checked",
        "target": "attribute",
        "name": "checked"
      },
      {
        "field": "value",
        "target": "attribute",
        "name": "value"
      },
      {
        "field": "name",
        "target": "attribute",
        "name": "name"
      },
      {
        "field": "disabled",
        "target": "attribute",
        "name": "disabled"
      }
    ],
    "eventBindings": [
      {
        "event": "change",
        "name": "change",
        "data": [
          {
            "path": "checked",
            "source": {
              "kind": "native",
              "path": "currentTarget.checked"
            }
          }
        ]
      }
    ]
  },
  "previewData": {
    "fields": {
      "checked": false,
      "value": "yes",
      "name": "accepted",
      "disabled": false
    }
  },
  "styles": {
    "declarations": {
      "accentColor": "{color.accent.default}",
      "width": "16px",
      "height": "16px"
    },
    "states": {
      "focus-visible": {
        "outline": "2px solid {color.accent.default}",
        "outlineOffset": "2px"
      },
      "disabled": {
        "opacity": "0.55"
      }
    }
  },
  "tokenInterface": {
    "reads": ["color.accent.default"]
  }
