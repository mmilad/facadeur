{
  "version": 1,
  "id": "form-checkbox",
  "name": "Checkbox",
  "kind": "atom",
  "group": "form",
  "fields": [
    {
      "name": "checked",
      "type": "boolean"
    },
    {
      "name": "value",
      "type": "text"
    },
    {
      "name": "name",
      "type": "text"
    },
    {
      "name": "disabled",
      "type": "boolean"
    }
  ],
  "events": [
