{
  "version": 1,
  "id": "project-template",
  "name": "Project template",
  "kind": "atom",
  "root": {
    "id": "root",
    "tag": "div",
    "type": "frame"
  },
  "settings": {
    "breakpoints": [
      {
        "id": "mobile",
        "minWidth": 375
      },
      {
        "id": "tablet",
        "minWidth": 768
      },
      {
        "id": "desktop",
        "minWidth": 1440
      }
    ]
  },
  "fonts": [
    {
      "id": "sans",
      "family": "Inter",
      "weights": [400, 500, 600, 700],
      "source": {
        "type": "google",
        "family": "Inter"
      },
      "fallbacks": ["system-ui", "sans-serif"]
    }
  ],
  "icons": [
    {
      "id": "select",
      "name": "Select",
      "category": "tools",
      "src": "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22%3E%3Cpath d=%22m5 3 13 11-5.6.7L9.3 20 5 3Z%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.8%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E"
    },
    {
      "id": "frame",
      "name": "Frame",
      "category": "tools",
      "src": "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22%3E%3Crect x=%224%22 y=%224%22 width=%2216%22 height=%2216%22 rx=%222%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.8%22/%3E%3C/svg%3E"
    },
    {
      "id": "text",
      "name": "Text",
      "category": "tools",
      "src": "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22%3E%3Cpath d=%22M5 5h14M12 5v14M8.5 19h7%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.8%22 stroke-linecap=%22round%22/%3E%3C/svg%3E"
    },
    {
      "id": "image",
      "name": "Image",
      "category": "tools",
      "src": "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22%3E%3Crect x=%224%22 y=%225%22 width=%2216%22 height=%2214%22 rx=%222%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.8%22/%3E%3Ccircle cx=%229%22 cy=%2210%22 r=%221.5%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.8%22/%3E%3Cpath d=%22m5 17 4-4 3 3 2-2 5 4%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.8%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E"
    },
    {
      "id": "chevron-down",
      "name": "Chevron down",
      "category": "controls",
      "src": "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22%3E%3Cpath d=%22m4 6 4 4 4-4%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.5%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E"
    },
    {
      "id": "search",
      "name": "Search",
      "category": "controls",
      "src": "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22%3E%3Ccircle cx=%226.5%22 cy=%226.5%22 r=%223.5%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.5%22/%3E%3Cpath d=%22m9.2 9.2 4.2 4.2%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.5%22 stroke-linecap=%22round%22/%3E%3C/svg%3E"
    },
    {
      "id": "plus",
      "name": "Plus",
      "category": "actions",
      "src": "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22%3E%3Cpath d=%22M8 3v10M3 8h10%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.5%22 stroke-linecap=%22round%22/%3E%3C/svg%3E"
    },
    {
      "id": "close",
      "name": "Close",
      "category": "actions",
      "src": "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22%3E%3Cpath d=%22m4 4 8 8M12 4l-8 8%22 fill=%22none%22 stroke=%22%231c1915%22 stroke-width=%221.5%22 stroke-linecap=%22round%22/%3E%3C/svg%3E"
    }
  ],
  "tokens": {
      "button": {
      "$extensions": {
        "facadeur": {
          "tier": "component"
        }
      },
      "color": {
        "$type": "color",
        "bg": {
          "$value": "{color.accent.default}"
        },
        "text": {
          "$value": "{color.text.inverse}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.gap.sm}"
      },
      "padding": {
        "$type": "dimension",
        "x": {
          "$value": "{space.4}"
        },
        "y": {
          "$value": "{space.2}"
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      }
    },
    "card": {
      "$extensions": {
        "facadeur": {
          "tier": "component"
        }
      },
      "color": {
        "$type": "color",
        "bg": {
          "$value": "{color.bg.canvas}"
        },
        "border": {
          "$value": "{color.border.default}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.gap.md}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.inset.lg}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.lg}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.md}"
      }
    },
    "editor": {
      "$extensions": {
        "facadeur": {
          "tier": "component"
        }
      },
      "color": {
        "$type": "color",
        "surface": {
          "$value": "{color.neutral.0}"
        },
        "canvas": {
          "$value": "{color.neutral.50}"
        },
        "border": {
          "$value": "{color.neutral.400}"
        },
        "bordersubtle": {
          "$value": "{color.neutral.200}"
        },
        "focus": {
          "$value": "{color.accent.default}"
        },
        "text": {
          "$value": "{color.text.primary}"
        },
        "textmuted": {
          "$value": "{color.text.secondary}"
        },
        "danger": {
          "$value": "{color.danger.default}"
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      },
      "padding": {
        "$type": "dimension",
        "x": {
          "$value": "{space.3}"
        },
        "y": {
          "$value": "{space.2}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.gap.xs}"
      }
    },
    "color": {
      "$extensions": {
        "facadeur": {
          "tier": "primitive"
        }
      },
      "$type": "color",
      "accent": {
        "$extensions": {
          "facadeur": {
            "tier": "semantic"
          }
        },
        "default": {
          "$value": "{color.blue.500}"
        },
        "hover": {
          "$value": "{color.blue.600}"
        }
      },
      "bg": {
        "$extensions": {
          "facadeur": {
            "tier": "semantic"
          }
        },
        "canvas": {
          "$value": "{color.neutral.0}"
        },
        "inverse": {
          "$value": "{color.neutral.900}"
        },
        "muted": {
          "$value": "{color.neutral.50}"
        }
      },
      "blue": {
        "500": {
          "$value": "#2563eb"
        },
        "600": {
          "$value": "#1d4ed8"
        }
      },
      "border": {
        "$extensions": {
          "facadeur": {
            "tier": "semantic"
          }
        },
        "default": {
          "$value": "{color.neutral.200}"
        }
      },
      "danger": {
        "$extensions": {
          "facadeur": {
            "tier": "semantic"
          }
        },
        "default": {
          "$value": "{color.red.500}"
        }
      },
      "green": {
        "600": {
          "$value": "#16a34a"
        }
      },
      "neutral": {
        "0": {
          "$value": "#ffffff"
        },
        "50": {
          "$value": "#f8fafc"
        },
        "100": {
          "$value": "#f1f5f9"
        },
        "200": {
          "$value": "#e2e8f0"
        },
        "400": {
          "$value": "#94a3b8"
        },
        "600": {
          "$value": "#475569"
        },
        "900": {
          "$value": "#0f172a"
        }
      },
      "red": {
        "500": {
          "$value": "#dc2626"
        }
      },
      "success": {
        "$extensions": {
          "facadeur": {
            "tier": "semantic"
          }
        },
        "default": {
          "$value": "{color.green.600}"
        }
      },
      "text": {
        "$extensions": {
          "facadeur": {
            "tier": "semantic"
          }
        },
        "inverse": {
          "$value": "{color.neutral.0}"
        },
        "primary": {
          "$value": "{color.neutral.900}"
        },
        "secondary": {
          "$value": "{color.neutral.600}"
        }
      }
    },
    "font": {
      "weight": {
        "$extensions": {
          "facadeur": {
            "tier": "primitive"
          }
        },
        "$type": "fontWeight",
        "bold": {
          "$value": 700
        },
        "medium": {
          "$value": 500
        },
        "regular": {
          "$value": 400
        },
        "semibold": {
          "$value": 600
        }
      }
    },
    "input": {
      "$extensions": {
        "facadeur": {
          "tier": "component"
        }
      },
      "color": {
        "$type": "color",
        "bg": {
          "$value": "{color.bg.canvas}"
        },
        "border": {
          "$value": "{color.neutral.600}"
        },
        "text": {
          "$value": "{color.text.primary}"
        }
      },
      "padding": {
        "$type": "dimension",
        "x": {
          "$value": "{space.3}"
        },
        "y": {
          "$value": "{space.1}"
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadow.sm}"
      }
    },
    "radius": {
      "$extensions": {
        "facadeur": {
          "tier": "primitive"
        }
      },
      "$type": "dimension",
      "full": {
        "$value": "999px"
      },
      "lg": {
        "$value": "12px"
      },
      "md": {
        "$value": "8px"
      },
      "none": {
        "$value": "0"
      },
      "sm": {
        "$value": "4px"
      },
      "xl": {
        "$value": "16px"
      }
    },
    "shadow": {
      "$extensions": {
        "facadeur": {
          "tier": "primitive"
        }
      },
      "$type": "shadow",
      "lg": {
        "$value": {
          "blur": "40px",
          "color": "#0f172a29",
          "offsetX": "0px",
          "offsetY": "16px",
          "spread": "0px"
        }
      },
      "md": {
        "$value": {
          "blur": "24px",
          "color": "#0f172a1f",
          "offsetX": "0px",
          "offsetY": "8px",
          "spread": "0px"
        }
      },
      "sm": {
        "$value": {
          "blur": "2px",
          "color": "#0f172a14",
          "offsetX": "0px",
          "offsetY": "1px",
          "spread": "0px"
        }
      }
    },
    "space": {
      "0": {
        "$value": "0"
      },
      "1": {
        "$value": "4px"
      },
      "2": {
        "$value": "8px"
      },
      "3": {
        "$value": "12px"
      },
      "4": {
        "$value": "16px"
      },
      "5": {
        "$value": "20px"
      },
      "6": {
        "$value": "24px"
      },
      "8": {
        "$value": "32px"
      },
      "10": {
        "$value": "40px"
      },
      "12": {
        "$value": "48px"
      },
      "16": {
        "$value": "64px"
      },
      "20": {
        "$value": "80px"
      },
      "24": {
        "$value": "96px"
      },
      "$description": "4px spacing grid. gap, padding, and margin use space.gap, space.inset, and space.stack.",
      "$extensions": {
        "facadeur": {
          "tier": "primitive"
        }
      },
      "$type": "dimension",
      "gap": {
        "$extensions": {
          "facadeur": {
            "tier": "semantic"
          }
        },
        "lg": {
          "$value": "{space.6}"
        },
        "md": {
          "$value": "{space.4}"
        },
        "sm": {
          "$value": "{space.2}"
        },
        "xs": {
          "$value": "{space.1}"
        }
      },
      "inset": {
        "$extensions": {
          "facadeur": {
            "tier": "semantic"
          }
        },
        "lg": {
          "$value": "{space.6}"
        },
        "md": {
          "$value": "{space.4}"
        },
        "sm": {
          "$value": "{space.3}"
        },
        "xs": {
          "$value": "{space.2}"
        }
      },
      "stack": {
        "$extensions": {
          "facadeur": {
            "tier": "semantic"
          }
        },
        "lg": {
          "$value": "{space.8}"
        },
        "md": {
          "$value": "{space.4}"
        },
        "sm": {
          "$value": "{space.2}"
        },
        "xs": {
          "$value": "{space.1}"
        }
      }
    },
    "type": {
      "$extensions": {
        "facadeur": {
          "tier": "semantic"
        }
      },
      "$type": "typography",
      "body": {
        "$extensions": {
          "facadeur": {
            "breakpoints": {
              "desktop": {
                "fontSize": "18px"
              },
              "tablet": {
                "fontSize": "17px"
              }
            }
          }
        },
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "16px",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "0",
          "lineHeight": 1.5
        }
      },
      "caption": {
        "$extensions": {
          "facadeur": {
            "breakpoints": {
              "desktop": {
                "fontSize": "13px"
              }
            }
          }
        },
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "12px",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "0",
          "lineHeight": 1.4
        }
      },
      "display": {
        "$extensions": {
          "facadeur": {
            "breakpoints": {
              "desktop": {
                "fontSize": "56px"
              },
              "tablet": {
                "fontSize": "48px"
              }
            }
          }
        },
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "40px",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "0",
          "lineHeight": 1.1
        }
      },
      "heading": {
        "$extensions": {
          "facadeur": {
            "breakpoints": {
              "desktop": {
                "fontSize": "40px"
              },
              "tablet": {
                "fontSize": "36px"
              }
            }
          }
        },
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "32px",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "0",
          "lineHeight": 1.2
        }
      },
      "label": {
        "$extensions": {
          "facadeur": {
            "breakpoints": {
              "desktop": {
                "fontSize": "15px"
              }
            }
          }
        },
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "14px",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": "0",
          "lineHeight": 1.4
        }
      },
      "title": {
        "$extensions": {
          "facadeur": {
            "breakpoints": {
              "desktop": {
                "fontSize": "28px"
              },
              "tablet": {
                "fontSize": "26px"
              }
            }
          }
        },
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "24px",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "0",
          "lineHeight": 1.25
        }
      }
    }
  }
}
