{
  "_instructions": "This file is the schema library the Schemas tab loads. To add a schema, append an object to schemas with a stable id, a name, a short description, and a JSON Schema in schema. Use type object and properties for a component field list. Property types are string, number, integer, or boolean. Put required names in required. A oneOf schema used as a component contract must also declare its flat editor fields in root properties; the oneOf branches then constrain valid shapes without being flattened into that contract. To attach a schema to an example component, set assignments to { documentId: schemaId }. Reload the editor after editing this file. A schema changed in the browser is stored in local storage and then overrides this file for that id.",
  "assignments": {
    "form-input": "input",
    "textarea": "textarea",
    "card": "card",
    "media": "media"
  },
  "schemas": [
    {
      "id": "input",
      "name": "Input",
      "description": "Native input fields owned by the Input atom. Wrapper labels are declared locally on the Input component.",
      "schema": {
        "type": "object",
        "title": "Input",
        "properties": {
          "value": { "type": "string", "title": "Value" },
          "placeholder": { "type": "string", "title": "Placeholder" },
          "name": { "type": "string", "title": "Name" },
          "disabled": { "type": "boolean", "title": "Disabled" }
        }
      }
    },
    {
      "id": "textarea",
      "name": "Textarea",
      "description": "Text control props from the Textarea component, including rows.",
      "schema": {
        "type": "object",
        "title": "Textarea",
        "properties": {
          "label": { "type": "string", "title": "Label" },
          "value": { "type": "string", "title": "Value" },
          "placeholder": { "type": "string", "title": "Placeholder" },
          "name": { "type": "string", "title": "Name" },
          "rows": { "type": "number", "title": "Rows" }
        }
      }
    },
    {
      "id": "image",
      "name": "Image",
      "description": "Image source, alt text, and aspect ratio.",
      "schema": {
        "type": "object",
        "title": "Image",
        "required": ["src"],
        "properties": {
          "src": { "type": "string", "title": "Source" },
          "alt": { "type": "string", "title": "Alt text" },
          "ratio": { "type": "string", "title": "Ratio" }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "video",
      "name": "Video",
      "description": "Video source, poster frame, and aspect ratio.",
      "schema": {
        "type": "object",
        "title": "Video",
        "required": ["src"],
        "properties": {
          "src": { "type": "string", "title": "Source" },
          "poster": { "type": "string", "title": "Poster" },
          "ratio": { "type": "string", "title": "Ratio" }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "fullbleed-teaser",
      "name": "Full-bleed teaser",
      "description": "Hero image, copy, and call to action.",
      "schema": {
        "type": "object",
        "title": "Full-bleed teaser",
        "required": ["title", "imageSrc"],
        "properties": {
          "title": { "type": "string", "title": "Title" },
          "body": { "type": "string", "title": "Body" },
          "imageSrc": { "type": "string", "title": "Image source" },
          "imageAlt": { "type": "string", "title": "Image alt" },
          "ctaLabel": { "type": "string", "title": "CTA label" },
          "ctaHref": { "type": "string", "title": "CTA href" }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "card",
      "name": "Card",
      "description": "Copy fields from the Card component.",
      "schema": {
        "type": "object",
        "title": "Card",
        "properties": {
          "eyebrow": { "type": "string", "title": "Eyebrow" },
          "title": { "type": "string", "title": "Title" },
          "body": { "type": "string", "title": "Body" }
        }
      }
    },
    {
      "id": "media",
      "name": "Media",
      "description": "Media editor contract with image and video variants.",
      "schema": {
        "type": "object",
        "title": "Media",
        "required": ["kind", "src"],
        "properties": {
          "kind": { "type": "string", "enum": ["image", "video"], "title": "Media kind" },
          "src": { "type": "string", "title": "Source" },
          "alt": { "type": "string", "title": "Alt text" },
          "poster": { "type": "string", "title": "Poster" },
          "ratio": { "type": "string", "title": "Ratio" }
        },
        "oneOf": [
          {
            "$ref": "facadeur://schema/image"
          },
          {
            "$ref": "facadeur://schema/video"
          }
        ]
      }
    }
  ]
}
