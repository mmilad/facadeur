{
  "version": 1,
  "id": "form-text-input",
  "name": "Text field",
  "kind": "component",
  "group": "form",
  "fields": [
    { "name": "label", "type": "text", "default": "Label" },
    { "name": "hint", "type": "text", "default": "Optional hint" },
    { "name": "icon", "type": "image" },
    { "name": "hasIcon", "type": "boolean", "default": false }
  ],
  "expose": {
    "fields": {
      "value": "control.value",
      "placeholder": "control.placeholder"
    },
    "events": { "commit": "control.commit" }
  },
  "variants": [
    {
      "name": "state",
      "values": ["default", "focused", "disabled", "invalid"],
      "default": "default"
    }
  ],
  "tokenInterface": {
    "reads": [
      "color.neutral.50",
      "color.text.primary",
      "color.text.secondary",
      "editor.color.border",
      "editor.color.canvas",
      "editor.color.danger",
      "editor.color.focus",
      "editor.color.surface",
      "editor.color.text",
      "editor.color.textmuted",
      "editor.gap",
      "editor.padding.x",
      "editor.padding.y",
      "editor.radius",
      "input.padding.x",
      "input.padding.y",
      "space.0",
      "type.body",
      "type.caption"
    ]
  },
  "styles": {
    "declarations": {
      "color": "{editor.color.text}",
      "font": "{type.body}"
    },
    "children": {
      "label": {
        "declarations": {
          "color": "{editor.color.textmuted}",
          "font": "{type.caption}",
          "fontWeight": "600",
          "margin": "{space.0}"
        }
      },
      "controlShell": {
        "declarations": {
          "alignItems": "center",
          "background": "{editor.color.surface}",
          "border": "1px solid {editor.color.border}",
          "borderRadius": "{editor.radius}",
          "display": "flex",
          "paddingBlock": "{input.padding.y}",
          "paddingInline": "{input.padding.x}"
        },
        "variants": {
          "state": {
            "focused": {
              "declarations": {
                "borderColor": "{editor.color.focus}",
                "boxShadow": "0 0 0 2px {editor.color.focus}"
              }
            },
            "disabled": {
              "declarations": {
                "background": "{editor.color.canvas}",
                "cursor": "not-allowed",
                "opacity": "0.65"
              }
            },
            "invalid": {
              "declarations": {
                "borderColor": "{editor.color.danger}",
                "boxShadow": "0 0 0 2px {editor.color.danger}"
              }
            }
          }
        }
      },
      "leadingIcon": {
        "declarations": {
          "flex": "0 0 16px",
          "height": "16px",
          "marginInlineEnd": "{editor.gap}",
          "opacity": "0.72",
          "width": "16px"
        }
      },
      "hint": {
        "declarations": {
          "color": "{editor.color.textmuted}",
          "font": "{type.caption}",
          "margin": "{space.0}"
        }
      }
    }
  },
  "root": {
    "id": "root",
    "type": "frame",
    "tag": "label",
    "layout": {
      "direction": "column",
      "align": "stretch",
      "gap": "{editor.gap}",
      "width": { "mode": "fill" },
      "height": { "mode": "hug" }
    },
    "children": [
      {
        "id": "label",
        "type": "text",
        "tag": "span",
        "layout": { "width": { "mode": "hug" }, "height": { "mode": "hug" } },
        "bindings": [{ "field": "label", "target": "text" }]
      },
      {
        "id": "controlShell",
        "type": "frame",
        "tag": "div",
        "layout": {
          "direction": "row",
          "align": "center",
          "width": { "mode": "fill" },
          "height": { "mode": "hug" }
        },
        "children": [
          {
            "id": "leadingIcon",
            "type": "image",
            "alt": "",
            "attributes": { "aria-hidden": "true" },
            "layout": {
              "width": { "mode": "fixed", "size": 16 },
              "height": { "mode": "fixed", "size": 16 }
            },
            "bindings": [
              { "field": "icon", "target": "src" },
              { "field": "hasIcon", "target": "visible" }
            ]
          },
          {
            "id": "control",
            "type": "instance",
            "component": "form-input"
          }
        ]
      },
      {
        "id": "hint",
        "type": "text",
        "tag": "span",
        "layout": { "width": { "mode": "hug" }, "height": { "mode": "hug" } },
        "bindings": [{ "field": "hint", "target": "text" }]
      }
    ]
  }
}
