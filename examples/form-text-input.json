{
  "version": 1,
  "id": "form-text-input",
  "previewData": {
    "fields": {
      "label": "Work email",
      "hint": "Use your work email address.",
      "hasIcon": false
    }
  },
  "name": "Text field",
  "kind": "component",
  "group": "form",
  "fields": [
    {
      "name": "label",
      "type": "text"
    },
    {
      "name": "hint",
      "type": "text"
    },
    {
      "name": "icon",
      "type": "image"
    },
    {
      "name": "hasIcon",
      "type": "boolean"
    }
  ],
  "expose": {
    "fields": {
      "value": "control.value",
      "placeholder": "control.placeholder"
    },
    "events": {
      "commit": "control.commit"
    }
  },
  "variants": [
    {
      "name": "state",
      "values": ["default", "focused", "disabled", "invalid"],
      "default": "default"
    }
  ],
  "tokenInterface": {
    "reads": [
      "color.accent.default",
      "color.danger.default",
      "color.neutral.0",
      "color.neutral.400",
      "color.neutral.50",
      "color.text.primary",
      "color.text.secondary",
      "input.padding.x",
      "input.padding.y",
      "padding.x",
      "padding.y",
      "radius.sm",
      "space.0",
      "space.gap.xs",
      "type.body",
      "type.caption"
    ]
  },
  "styles": {
    "declarations": {
      "color": "{color.text}",
      "font": "{type.body}"
    },
    "children": {
      "label": {
        "declarations": {
          "color": "{color.textmuted}",
          "font": "{type.caption}",
          "fontWeight": "600",
          "margin": "{space.0}"
        }
      },
      "controlShell": {
        "declarations": {
          "alignItems": "center",
          "background": "{color.surface}",
          "border": "1px solid {color.border}",
          "borderRadius": "{shape.radius}",
          "display": "flex",
          "paddingBlock": "{input.padding.y}",
          "paddingInline": "{input.padding.x}"
        },
        "variants": {
          "state": {
            "focused": {
              "declarations": {
                "borderColor": "{color.focus}",
                "boxShadow": "0 0 0 2px {color.focus}"
              }
            },
            "disabled": {
              "declarations": {
                "background": "{color.canvas}",
                "cursor": "not-allowed",
                "opacity": "0.65"
              }
            },
            "invalid": {
              "declarations": {
                "borderColor": "{color.danger}",
                "boxShadow": "0 0 0 2px {color.danger}"
              }
            }
          }
        }
      },
      "leadingIcon": {
        "declarations": {
          "flex": "0 0 16px",
          "height": "16px",
          "marginInlineEnd": "{layout.gap}",
          "opacity": "0.72",
          "width": "16px"
        }
      },
      "hint": {
        "declarations": {
          "color": "{color.textmuted}",
          "font": "{type.caption}",
          "margin": "{space.0}"
        }
      }
    }
  },
  "root": {
    "id": "root",
    "type": "frame",
    "tag": "label",
    "layout": {
      "direction": "column",
      "align": "stretch",
      "gap": "{layout.gap}",
      "width": {
        "mode": "fill"
      },
      "height": {
        "mode": "hug"
      }
    },
    "children": [
      {
        "id": "label",
        "type": "text",
        "tag": "span",
        "layout": {
          "width": {
            "mode": "hug"
          },
          "height": {
            "mode": "hug"
          }
        },
        "bindings": [
          {
            "field": "label",
            "target": "text"
          }
        ]
      },
      {
        "id": "controlShell",
        "type": "frame",
        "tag": "div",
        "layout": {
          "direction": "row",
          "align": "center",
          "width": {
            "mode": "fill"
          },
          "height": {
            "mode": "hug"
          }
        },
        "children": [
          {
            "id": "leadingIcon",
            "type": "image",
            "alt": "",
            "attributes": {
              "aria-hidden": "true"
            },
            "layout": {
              "width": {
                "mode": "fixed",
                "size": 16
              },
              "height": {
                "mode": "fixed",
                "size": 16
              }
            },
            "bindings": [
              {
                "field": "icon",
                "target": "src"
              },
              {
                "field": "hasIcon",
                "target": "visible"
              }
            ]
          },
          {
            "id": "control",
            "type": "instance",
            "component": "form-input"
          }
        ]
      },
      {
        "id": "hint",
        "type": "text",
        "tag": "span",
        "layout": {
          "width": {
            "mode": "hug"
          },
          "height": {
            "mode": "hug"
          }
        },
        "bindings": [
          {
            "field": "hint",
            "target": "text"
          }
        ]
      }
    ]
  },
  "componentTokens": {
    "color.border": {
      "type": "color",
      "value": "{color.neutral.400}"
    },
    "color.canvas": {
      "type": "color",
      "value": "{color.neutral.50}"
    },
    "color.danger": {
      "type": "color",
      "value": "{color.danger.default}"
    },
    "color.focus": {
      "type": "color",
      "value": "{color.accent.default}"
    },
    "color.surface": {
      "type": "color",
      "value": "{color.neutral.0}"
    },
    "color.text": {
      "type": "color",
      "value": "{color.text.primary}"
    },
    "color.textmuted": {
      "type": "color",
      "value": "{color.text.secondary}"
    },
    "layout.gap": {
      "type": "dimension",
      "value": "{space.gap.xs}"
    },
    "shape.radius": {
      "type": "dimension",
      "value": "{radius.sm}"
    }
  }
}
