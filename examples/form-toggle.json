{
  "version": 1,
  "id": "form-toggle",
  "name": "Toggle",
  "kind": "component",
  "group": "form",
  "fields": [
    {
      "name": "label",
      "type": "text"
    },
    {
      "name": "value",
      "type": "text"
    }
  ],
  "variants": [
    {
      "name": "state",
      "values": [
        "on",
        "off",
        "disabled"
      ],
      "default": "on"
    }
  ],
  "tokenInterface": {
    "reads": [
      "color.accent.default",
      "color.bg.muted",
      "color.text.inverse",
      "color.text.primary",
      "color.text.secondary",
      "radius.full",
      "space.0",
      "space.2",
      "space.4",
      "type.body",
      "type.caption"
    ]
  },
  "styles": {
    "children": {
      "label": {
        "declarations": {
          "color": "{color.text}",
          "font": "{type.body}",
          "margin": "{space.0}"
        }
      },
      "control": {
        "declarations": {
          "alignItems": "center",
          "display": "flex",
          "gap": "{space.2}"
        }
      },
      "switch": {
        "declarations": {
          "alignItems": "center",
          "background": "{color.accent.default}",
          "border": "2px solid transparent",
          "borderRadius": "{radius.full}",
          "display": "flex",
          "height": "20px",
          "justifyContent": "flex-end",
          "width": "36px"
        },
        "variants": {
          "state": {
            "off": {
              "declarations": {
                "background": "{color.bg.muted}",
                "justifyContent": "flex-start"
              }
            },
            "disabled": {
              "declarations": {
                "background": "{color.bg.muted}",
                "opacity": "0.6"
              }
            }
          }
        }
      },
      "thumb": {
        "declarations": {
          "background": "{color.text.inverse}",
          "borderRadius": "{radius.full}",
          "flex": "0 0 16px",
          "height": "16px",
          "width": "16px"
        }
      },
      "state": {
        "declarations": {
          "color": "{color.textmuted}",
          "font": "{type.caption}"
        }
      }
    }
  },
  "root": {
    "id": "root",
    "type": "frame",
    "tag": "label",
    "layout": {
      "direction": "row",
      "align": "center",
      "justify": "space-between",
      "gap": "{space.4}",
      "width": {
        "mode": "fill"
      },
      "height": {
        "mode": "hug"
      }
    },
    "children": [
      {
        "id": "label",
        "type": "text",
        "tag": "span",
        "layout": {
          "width": {
            "mode": "hug"
          },
          "height": {
            "mode": "hug"
          }
        },
        "bindings": [
          {
            "field": "label",
            "target": "text"
          }
        ]
      },
      {
        "id": "control",
        "type": "frame",
        "tag": "div",
        "layout": {
          "direction": "row",
          "align": "center",
          "gap": "{space.2}",
          "width": {
            "mode": "hug"
          },
          "height": {
            "mode": "hug"
          }
        },
        "children": [
          {
            "id": "switch",
            "type": "frame",
            "tag": "div",
            "layout": {
              "direction": "row",
              "align": "center",
              "width": {
                "mode": "fixed",
                "size": 36
              },
              "height": {
                "mode": "fixed",
                "size": 20
              }
            },
            "children": [
              {
                "id": "thumb",
                "type": "frame",
                "tag": "span",
                "layout": {
                  "width": {
                    "mode": "fixed",
                    "size": 16
                  },
                  "height": {
                    "mode": "fixed",
                    "size": 16
                  }
                }
              }
            ]
          },
          {
            "id": "state",
            "type": "text",
            "tag": "span",
            "layout": {
              "width": {
                "mode": "hug"
              },
              "height": {
                "mode": "hug"
              }
            },
            "bindings": [
              {
                "field": "value",
                "target": "text"
              }
            ]
          }
        ]
      }
    ]
  },
  "componentTokens": {
    "color.text": {
      "type": "color",
      "value": "{color.text.primary}"
    },
    "color.textmuted": {
      "type": "color",
      "value": "{color.text.secondary}"
    }
  }
}
