{
  "version": 1,
  "id": "form-controls-section",
  "name": "Form controls section",
  "kind": "component",
  "group": "form",
  "tokenInterface": {
    "reads": [
      "color.bg.canvas",
      "color.text.primary",
      "color.text.secondary",
      "editor.color.bordersubtle",
      "editor.color.text",
      "editor.color.textmuted",
      "editor.gap",
      "editor.padding.x",
      "editor.padding.y",
      "editor.radius",
      "space.0",
      "space.2",
      "space.3",
      "space.4",
      "space.6",
      "space.8",
      "space.gap.lg",
      "space.gap.md",
      "space.gap.sm",
      "type.body",
      "type.caption",
      "type.heading",
      "type.title"
    ]
  },
  "styles": {
    "children": {
      "eyebrow": {
        "declarations": {
          "color": "{color.text.secondary}",
          "font": "{type.caption}",
          "fontWeight": "600",
          "letterSpacing": "0.12em",
          "margin": "{space.0}",
          "textTransform": "uppercase"
        }
      },
      "title": {
        "declarations": {
          "color": "{color.text.primary}",
          "font": "{type.title}",
          "margin": "{space.0}"
        }
      },
      "intro-text": {
        "declarations": { "color": "{color.text.secondary}", "font": "{type.body}" }
      },
      "text-input-title": {
        "declarations": {
          "color": "{color.text.primary}",
          "font": "{type.heading}",
          "margin": "{space.0}"
        }
      },
      "native-text-controls-title": {
        "declarations": {
          "color": "{color.text.primary}",
          "font": "{type.heading}",
          "margin": "{space.0}"
        }
      },
      "selection-title": {
        "declarations": {
          "color": "{color.text.primary}",
          "font": "{type.heading}",
          "margin": "{space.0}"
        }
      },
      "field-title": {
        "declarations": {
          "color": "{color.text.primary}",
          "font": "{type.heading}",
          "margin": "{space.0}"
        }
      },
      "field-note": {
        "declarations": {
          "color": "{color.text.secondary}",
          "font": "{type.caption}",
          "margin": "{space.0}"
        }
      },
      "field-list": {
        "declarations": {
          "border": "1px solid {editor.color.bordersubtle}",
          "borderRadius": "{editor.radius}"
        }
      }
    }
  },
  "fields": [
    {
      "name": "formFields",
      "type": "array",
      "items": {
        "type": "object",
        "fields": [
          { "name": "id", "type": "text", "required": true },
          {
            "name": "kind",
            "type": "enum",
            "required": true,
            "options": ["input", "textarea", "select", "toggle"]
          },
          { "name": "label", "type": "text", "required": true },
          { "name": "value", "type": "text" },
          { "name": "placeholder", "type": "text" },
          { "name": "hint", "type": "text" },
          { "name": "rows", "type": "number" }
        ]
      },
      "default": [
        {
          "id": "name",
          "kind": "input",
          "label": "Name",
          "placeholder": "Your name"
        },
        {
          "id": "message",
          "kind": "textarea",
          "label": "Message",
          "rows": 3
        },
        {
          "id": "property",
          "kind": "select",
          "label": "Property"
        },
        { "id": "enabled", "kind": "toggle", "label": "Use token" }
      ]
    }
  ],
  "root": {
    "id": "root",
    "type": "frame",
    "tag": "main",
    "layout": {
      "direction": "column",
      "align": "stretch",
      "gap": "{space.8}",
      "padding": "{space.8}",
      "width": { "mode": "fill" },
      "height": { "mode": "hug" }
    },
    "children": [
      {
        "id": "intro",
        "type": "frame",
        "tag": "header",
        "layout": {
          "direction": "column",
          "align": "start",
          "gap": "{space.4}",
          "width": { "mode": "fill" },
          "height": { "mode": "hug" }
        },
        "children": [
          {
            "id": "eyebrow",
            "type": "text",
            "tag": "p",
            "text": "facadeur · editor kit",
            "layout": { "width": { "mode": "hug" }, "height": { "mode": "hug" } }
          },
          {
            "id": "title",
            "type": "text",
            "tag": "h1",
            "text": "Controls",
            "layout": { "width": { "mode": "hug" }, "height": { "mode": "hug" } }
          },
          {
            "id": "intro-text",
            "type": "text",
            "tag": "p",
            "text": "A small, token-driven control language for the editor inspector.",
            "layout": { "width": { "mode": "fill", "max": 680 }, "height": { "mode": "hug" } }
          }
        ]
      },
      {
        "id": "native-text-controls",
        "type": "frame",
        "tag": "section",
        "layout": {
          "direction": "column",
          "align": "stretch",
          "gap": "{space.gap.md}",
          "width": { "mode": "fill" },
          "height": { "mode": "hug" }
        },
        "children": [
          {
            "id": "native-text-controls-title",
            "type": "text",
            "tag": "h2",
            "text": "Native text controls",
            "layout": { "width": { "mode": "hug" }, "height": { "mode": "hug" } }
          },
          {
            "id": "native-text-controls-row",
            "type": "frame",
            "tag": "div",
            "layout": {
              "direction": "row",
              "align": "start",
              "wrap": true,
              "gap": "{space.gap.md}",
              "width": { "mode": "fill" },
              "height": { "mode": "hug" }
            },
            "children": [
              {
                "id": "native-input",
                "type": "instance",
                "component": "input",
                "layout": {
                  "width": { "mode": "fixed", "size": 250 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Input", "value": "Value" }
              },
              {
                "id": "native-textarea",
                "type": "instance",
                "component": "textarea",
                "layout": {
                  "width": { "mode": "fixed", "size": 250 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Textarea", "value": "Write a message", "rows": 3 }
              }
            ]
          }
        ]
      },
      {
        "id": "text-inputs",
        "type": "frame",
        "tag": "section",
        "layout": {
          "direction": "column",
          "align": "stretch",
          "gap": "{space.gap.md}",
          "width": { "mode": "fill" },
          "height": { "mode": "hug" }
        },
        "children": [
          {
            "id": "text-input-title",
            "type": "text",
            "tag": "h2",
            "text": "Text field states",
            "layout": { "width": { "mode": "hug" }, "height": { "mode": "hug" } }
          },
          {
            "id": "text-input-row",
            "type": "frame",
            "tag": "div",
            "layout": {
              "direction": "row",
              "align": "start",
              "wrap": true,
              "gap": "{space.gap.md}",
              "width": { "mode": "fill" },
              "height": { "mode": "hug" }
            },
            "children": [
              {
                "id": "input-default",
                "type": "instance",
                "component": "form-text-input",
                "layout": {
                  "width": { "mode": "fixed", "size": 250 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Label", "value": "Button", "hint": "Default" },
                "variants": { "state": "default" }
              },
              {
                "id": "input-focused",
                "type": "instance",
                "component": "form-text-input",
                "layout": {
                  "width": { "mode": "fixed", "size": 250 },
                  "height": { "mode": "hug" }
                },
                "fields": {
                  "label": "Label",
                  "value": "Button",
                  "hint": "Focused",
                  "hasIcon": true,
                  "icon": "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22%3E%3Ccircle cx=%226.5%22 cy=%226.5%22 r=%223.5%22 fill=%22none%22 stroke=%22%236f675e%22 stroke-width=%221.5%22/%3E%3Cpath d=%22m9.2 9.2 4.2 4.2%22 fill=%22none%22 stroke=%22%236f675e%22 stroke-width=%221.5%22 stroke-linecap=%22round%22/%3E%3C/svg%3E"
                },
                "variants": { "state": "focused" }
              },
              {
                "id": "input-invalid",
                "type": "instance",
                "component": "form-text-input",
                "layout": {
                  "width": { "mode": "fixed", "size": 250 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Label", "value": "Button", "hint": "Invalid value" },
                "variants": { "state": "invalid" }
              },
              {
                "id": "input-disabled",
                "type": "instance",
                "component": "form-text-input",
                "layout": {
                  "width": { "mode": "fixed", "size": 250 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Label", "value": "Disabled", "hint": "Disabled" },
                "variants": { "state": "disabled" }
              }
            ]
          }
        ]
      },
      {
        "id": "selection",
        "type": "frame",
        "tag": "section",
        "layout": {
          "direction": "column",
          "align": "stretch",
          "gap": "{space.gap.md}",
          "width": { "mode": "fill" },
          "height": { "mode": "hug" }
        },
        "children": [
          {
            "id": "selection-title",
            "type": "text",
            "tag": "h2",
            "text": "Selection and options",
            "layout": { "width": { "mode": "hug" }, "height": { "mode": "hug" } }
          },
          {
            "id": "selection-row",
            "type": "frame",
            "tag": "div",
            "layout": {
              "direction": "row",
              "align": "start",
              "wrap": true,
              "gap": "{space.gap.lg}",
              "width": { "mode": "fill" },
              "height": { "mode": "hug" }
            },
            "children": [
              {
                "id": "select-default",
                "type": "instance",
                "component": "form-select",
                "layout": {
                  "width": { "mode": "fixed", "size": 250 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Token", "value": "color.text.primary" },
                "variants": { "state": "default" }
              },
              {
                "id": "select-focused",
                "type": "instance",
                "component": "form-select",
                "layout": {
                  "width": { "mode": "fixed", "size": 250 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Property", "value": "border color" },
                "variants": { "state": "focused" }
              },
              {
                "id": "select-disabled",
                "type": "instance",
                "component": "form-select",
                "layout": {
                  "width": { "mode": "fixed", "size": 250 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Breakpoint", "value": "Base" },
                "variants": { "state": "disabled" }
              },
              {
                "id": "alignment",
                "type": "instance",
                "component": "form-segmented",
                "layout": {
                  "width": { "mode": "fixed", "size": 270 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Alignment" },
                "variants": { "state": "start" }
              },
              {
                "id": "toggle-on",
                "type": "instance",
                "component": "form-toggle",
                "layout": {
                  "width": { "mode": "fixed", "size": 180 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Use token", "value": "On" },
                "variants": { "state": "on" }
              },
              {
                "id": "toggle-off",
                "type": "instance",
                "component": "form-toggle",
                "layout": {
                  "width": { "mode": "fixed", "size": 180 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Use token", "value": "Off" },
                "variants": { "state": "off" }
              },
              {
                "id": "toggle-disabled",
                "type": "instance",
                "component": "form-toggle",
                "layout": {
                  "width": { "mode": "fixed", "size": 180 },
                  "height": { "mode": "hug" }
                },
                "fields": { "label": "Use token", "value": "Disabled" },
                "variants": { "state": "disabled" }
              }
            ]
          }
        ]
      },
      {
        "id": "field-definition",
        "type": "frame",
        "tag": "section",
        "layout": {
          "direction": "column",
          "align": "stretch",
          "gap": "{space.gap.md}",
          "width": { "mode": "fill" },
          "height": { "mode": "hug" }
        },
        "children": [
          {
            "id": "field-title",
            "type": "text",
            "tag": "h2",
            "text": "Field definition",
            "layout": { "width": { "mode": "hug" }, "height": { "mode": "hug" } }
          },
          {
            "id": "field-note",
            "type": "text",
            "tag": "p",
            "text": "Compact rows keep component definitions scannable; details can open on demand.",
            "layout": { "width": { "mode": "fill" }, "height": { "mode": "hug" } }
          },
          {
            "id": "field-list",
            "type": "frame",
            "tag": "div",
            "layout": {
              "direction": "column",
              "align": "stretch",
              "gap": "{space.0}",
              "width": { "mode": "fill" },
              "height": { "mode": "hug" }
            },
            "children": [
              {
                "id": "field-header",
                "type": "frame",
                "tag": "div",
                "layout": {
                  "direction": "row",
                  "align": "center",
                  "gap": "{space.3}",
                  "padding": "{space.2}",
                  "width": { "mode": "fill" },
                  "height": { "mode": "hug" }
                },
                "children": [
                  {
                    "id": "column-name",
                    "type": "text",
                    "tag": "span",
                    "text": "Name",
                    "layout": {
                      "width": { "mode": "fixed", "size": 150 },
                      "height": { "mode": "hug" }
                    }
                  },
                  {
                    "id": "column-type",
                    "type": "text",
                    "tag": "span",
                    "text": "Type",
                    "layout": {
                      "width": { "mode": "fixed", "size": 100 },
                      "height": { "mode": "hug" }
                    }
                  },
                  {
                    "id": "column-default",
                    "type": "text",
                    "tag": "span",
                    "text": "Default",
                    "layout": { "width": { "mode": "fill" }, "height": { "mode": "hug" } }
                  }
                ]
              },
              {
                "id": "field-label",
                "type": "instance",
                "component": "form-field-row",
                "fields": { "name": "label", "type": "text", "value": "Button" }
              },
              {
                "id": "field-tone",
                "type": "instance",
                "component": "form-field-row",
                "fields": { "name": "tone", "type": "enum", "value": "primary" },
                "variants": { "state": "selected" }
              },
              {
                "id": "field-disabled",
                "type": "instance",
                "component": "form-field-row",
                "fields": { "name": "disabled", "type": "boolean", "value": "false" }
              }
            ]
          },
          {
            "id": "add-field",
            "type": "instance",
            "component": "button",
            "layout": { "width": { "mode": "hug" }, "height": { "mode": "hug" } },
            "fields": { "label": "+ Add field" },
            "variants": { "tone": "secondary", "size": "sm" }
          }
        ]
      },
      {
        "id": "data-driven-form",
        "type": "frame",
        "tag": "section",
        "layout": {
          "direction": "column",
          "align": "stretch",
          "gap": "{space.gap.md}",
          "width": { "mode": "fill" },
          "height": { "mode": "hug" }
        },
        "children": [
          {
            "id": "data-driven-title",
            "type": "text",
            "tag": "h2",
            "text": "Data-driven form",
            "layout": { "width": { "mode": "hug" }, "height": { "mode": "hug" } }
          },
          {
            "id": "data-form",
            "type": "frame",
            "tag": "div",
            "repeat": { "path": "formFields", "as": "field", "key": "id" },
            "layout": {
              "direction": "column",
              "align": "stretch",
              "gap": "{space.gap.md}",
              "width": { "mode": "fill" },
              "height": { "mode": "hug" }
            },
            "children": [
              {
                "id": "data-input",
                "type": "instance",
                "component": "form-text-input",
                "displayOn": { "path": "field.kind", "equals": "input" },
                "fieldBindings": {
                  "label": "field.label",
                  "hint": "field.hint",
                  "value": "field.value",
                  "placeholder": "field.placeholder"
                }
              },
              {
                "id": "data-textarea",
                "type": "instance",
                "component": "textarea",
                "displayOn": { "path": "field.kind", "equals": "textarea" },
                "fieldBindings": {
                  "label": "field.label",
                  "value": "field.value",
                  "placeholder": "field.placeholder",
                  "rows": "field.rows"
                }
              },
              {
                "id": "data-select",
                "type": "instance",
                "component": "form-select",
                "displayOn": { "path": "field.kind", "equals": "select" },
                "fieldBindings": { "label": "field.label", "value": "field.value" }
              },
              {
                "id": "data-toggle",
                "type": "instance",
                "component": "form-toggle",
                "displayOn": { "path": "field.kind", "equals": "toggle" },
                "fieldBindings": { "label": "field.label", "value": "field.value" }
              }
            ]
          }
        ]
      }
    ]
  }
}
