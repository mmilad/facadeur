{
  "version": 1,
  "id": "button",
  "name": "Button",
  "kind": "atom",
  "fields": [
    {
      "name": "label",
      "type": "text"
    }
  ],
  "variants": [
    {
      "name": "tone",
      "values": [
        "primary",
        "secondary",
        "ghost"
      ],
      "default": "primary"
    },
    {
      "name": "size",
      "values": [
        "sm",
        "md"
      ],
      "default": "md"
    }
  ],
  "tokenInterface": {
    "reads": [
      "color.accent.default",
      "color.accent.hover",
      "color.bg.muted",
      "color.border.default",
      "color.text.inverse",
      "color.text.primary",
      "color.text.secondary",
      "radius.full",
      "space.1",
      "space.2",
      "space.3",
      "space.4",
      "space.5",
      "space.gap.sm",
      "type.caption",
      "type.label"
    ]
  },
  "styles": {
    "declarations": {
      "appearance": "none",
      "background": "{color.bg}",
      "border": "1px solid transparent",
      "borderRadius": "{radius.full}",
      "color": "{color.text}",
      "cursor": "pointer",
      "font": "{type.label}",
      "letterSpacing": "0.01em",
      "lineHeight": "1",
      "paddingBlock": "{padding.y}",
      "paddingInline": "{padding.x}",
      "whiteSpace": "nowrap"
    },
    "states": {
      "hover": {
        "background": "{color.accent.hover}"
      },
      "focus-visible": {
        "outline": "2px solid {color.accent.default}",
        "outlineOffset": "2px"
      },
      "disabled": {
        "opacity": "0.5"
      }
    },
    "variants": {
      "size": {
        "sm": {
          "declarations": {
            "font": "{type.caption}",
            "paddingBlock": "{space.1}",
            "paddingInline": "{space.3}"
          }
        }
      },
      "tone": {
        "ghost": {
          "declarations": {
            "background": "transparent",
            "color": "{color.text.secondary}"
          },
          "states": {
            "hover": {
              "background": "{color.bg.muted}",
              "color": "{color.text.primary}"
            }
          }
        },
        "secondary": {
          "declarations": {
            "background": "transparent",
            "borderColor": "{color.border.default}",
            "color": "{color.text.primary}"
          },
          "states": {
            "hover": {
              "background": "{color.bg.muted}"
            }
          }
        }
      }
    },
    "breakpoints": {
      "sm": {
        "declarations": {
          "paddingInline": "{space.5}"
        }
      }
    }
  },
  "root": {
    "id": "root",
    "type": "frame",
    "tag": "button",
    "attributes": {
      "type": "button"
    },
    "layout": {
      "direction": "row",
      "align": "center",
      "justify": "center",
      "gap": "{layout.gap}",
      "width": {
        "mode": "hug"
      },
      "height": {
        "mode": "hug"
      }
    },
    "bindings": [
      {
        "field": "label",
        "target": "text"
      }
    ]
  },
  "componentTokens": {
    "padding.x": {
      "type": "dimension",
      "value": "{space.4}"
    },
    "padding.y": {
      "type": "dimension",
      "value": "{space.2}"
    },
    "layout.gap": {
      "type": "dimension",
      "value": "{space.gap.sm}"
    },
    "color.bg": {
      "type": "color",
      "value": "{color.accent.default}"
    },
    "color.text": {
      "type": "color",
      "value": "{color.text.inverse}"
    }
  }
}
