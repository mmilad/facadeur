{
  "version": 1,
  "id": "input",
  "previewData": {
    "fields": {
      "label": "Work email"
    }
  },
  "name": "Input",
  "kind": "component",
  "group": "form",
  "fields": [
    {
      "name": "label",
      "type": "text"
    }
  ],
  "expose": {
    "fields": {
      "value": "control.value",
      "placeholder": "control.placeholder",
      "name": "control.name"
    },
    "events": {
      "commit": "control.commit"
    }
  },
  "tokenInterface": {
    "reads": [
      "color.border.default",
      "color.text.secondary",
      "space.0",
      "space.gap.xs",
      "type.label"
    ]
  },
  "styles": {
    "declarations": {
      "color": "{color.text.secondary}",
      "font": "{type.label}"
    },
    "children": {
      "label": {
        "declarations": {
          "margin": "{space.0}"
        }
      }
    }
  },
  "root": {
    "id": "root",
    "type": "frame",
    "tag": "label",
    "layout": {
      "direction": "column",
      "align": "stretch",
      "gap": "{space.gap.xs}",
      "width": {
        "mode": "fill"
      },
      "height": {
        "mode": "hug"
      }
    },
    "children": [
      {
        "id": "label",
        "type": "text",
        "tag": "span",
        "bindings": [
          {
            "field": "label",
            "target": "text"
          }
        ]
      },
      {
        "id": "control",
        "type": "instance",
        "component": "form-input",
        "fieldBindings": {
          "value": "value",
          "placeholder": "placeholder",
          "name": "name"
        }
      }
    ]
  },
  "componentTokens": {
    "n_input_border": {
      "path": "color.border",
      "type": "color",
      "value": "{color.border.default}"
    },
    "n_dvpj32yugo": {
      "path": "color.text",
      "type": "color",
      "value": "{color.text.secondary}"
    }
  }
}
