{
  "version": 1,
  "id": "form-segmented",
  "name": "Segmented control",
  "kind": "component",
  "group": "form",
  "fields": [
    {
      "name": "label",
      "type": "text"
    }
  ],
  "variants": [
    {
      "name": "state",
      "values": [
        "start",
        "center",
        "end"
      ],
      "default": "start"
    }
  ],
  "tokenInterface": {
    "reads": [
      "color.bg.muted",
      "color.neutral.0",
      "color.neutral.400",
      "color.text.primary",
      "color.text.secondary",
      "radius.sm",
      "space.0",
      "space.2",
      "space.3",
      "space.gap.xs",
      "type.body",
      "type.caption"
    ]
  },
  "styles": {
    "children": {
      "label": {
        "declarations": {
          "color": "{color.textmuted}",
          "font": "{type.caption}",
          "fontWeight": "600",
          "margin": "{space.0}"
        }
      },
      "options": {
        "declarations": {
          "background": "{color.bg.muted}",
          "border": "1px solid {color.border}",
          "borderRadius": "{shape.radius}",
          "display": "flex",
          "font": "{type.caption}",
          "paddingBlock": "{padding.y}",
          "paddingInline": "{padding.x}"
        }
      },
      "start": {
        "declarations": {
          "color": "{color.textmuted}",
          "paddingBlock": "{padding.y}",
          "paddingInline": "{padding.x}"
        },
        "variants": {
          "state": {
            "start": {
              "declarations": {
                "background": "{color.surface}",
                "borderRadius": "{shape.radius}",
                "color": "{color.text}",
                "fontWeight": "600"
              }
            }
          }
        }
      },
      "center": {
        "declarations": {
          "color": "{color.textmuted}",
          "paddingBlock": "{padding.y}",
          "paddingInline": "{padding.x}"
        },
        "variants": {
          "state": {
            "center": {
              "declarations": {
                "background": "{color.surface}",
                "borderRadius": "{shape.radius}",
                "color": "{color.text}",
                "fontWeight": "600"
              }
            }
          }
        }
      },
      "end": {
        "declarations": {
          "color": "{color.textmuted}",
          "paddingBlock": "{padding.y}",
          "paddingInline": "{padding.x}"
        },
        "variants": {
          "state": {
            "end": {
              "declarations": {
                "background": "{color.surface}",
                "borderRadius": "{shape.radius}",
                "color": "{color.text}",
                "fontWeight": "600"
              }
            }
          }
        }
      }
    }
  },
  "root": {
    "id": "root",
    "type": "frame",
    "tag": "div",
    "layout": {
      "direction": "column",
      "align": "stretch",
      "gap": "{layout.gap}",
      "width": {
        "mode": "fill"
      },
      "height": {
        "mode": "hug"
      }
    },
    "children": [
      {
        "id": "label",
        "type": "text",
        "tag": "span",
        "layout": {
          "width": {
            "mode": "hug"
          },
          "height": {
            "mode": "hug"
          }
        },
        "bindings": [
          {
            "field": "label",
            "target": "text"
          }
        ]
      },
      {
        "id": "options",
        "type": "frame",
        "tag": "div",
        "layout": {
          "direction": "row",
          "align": "center",
          "gap": "{space.0}",
          "width": {
            "mode": "hug"
          },
          "height": {
            "mode": "hug"
          }
        },
        "children": [
          {
            "id": "start",
            "type": "text",
            "tag": "span",
            "text": "Start",
            "layout": {
              "width": {
                "mode": "hug"
              },
              "height": {
                "mode": "hug"
              }
            }
          },
          {
            "id": "center",
            "type": "text",
            "tag": "span",
            "text": "Center",
            "layout": {
              "width": {
                "mode": "hug"
              },
              "height": {
                "mode": "hug"
              }
            }
          },
          {
            "id": "end",
            "type": "text",
            "tag": "span",
            "text": "End",
            "layout": {
              "width": {
                "mode": "hug"
              },
              "height": {
                "mode": "hug"
              }
            }
          }
        ]
      }
    ]
  },
  "componentTokens": {
    "color.border": {
      "type": "color",
      "value": "{color.neutral.400}"
    },
    "color.surface": {
      "type": "color",
      "value": "{color.neutral.0}"
    },
    "color.text": {
      "type": "color",
      "value": "{color.text.primary}"
    },
    "color.textmuted": {
      "type": "color",
      "value": "{color.text.secondary}"
    },
    "layout.gap": {
      "type": "dimension",
      "value": "{space.gap.xs}"
    },
    "padding.x": {
      "type": "dimension",
      "value": "{space.3}"
    },
    "padding.y": {
      "type": "dimension",
      "value": "{space.2}"
    },
    "shape.radius": {
      "type": "dimension",
      "value": "{radius.sm}"
    }
  }
}
