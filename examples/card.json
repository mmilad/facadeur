{
  "version": 1,
  "id": "card",
  "name": "Card",
  "kind": "component",
  "fields": [
    { "name": "eyebrow", "type": "text", "default": "Card" },
    { "name": "title", "type": "text", "default": "Title" },
    { "name": "body", "type": "text", "default": "" }
  ],
  "root": {
    "id": "root",
    "type": "frame",
    "tag": "article",
    "attributes": { "class": "ds-card" },
    "children": [
      {
        "id": "eyebrow",
        "type": "text",
        "tag": "p",
        "attributes": { "class": "ds-card__eyebrow" },
        "bindings": [{ "field": "eyebrow", "target": "text" }]
      },
      {
        "id": "title",
        "type": "text",
        "tag": "h2",
        "attributes": { "class": "ds-card__title" },
        "bindings": [{ "field": "title", "target": "text" }]
      },
      {
        "id": "body",
        "type": "text",
        "tag": "p",
        "attributes": { "class": "ds-card__body" },
        "bindings": [{ "field": "body", "target": "text" }]
      }
    ]
  }
}
