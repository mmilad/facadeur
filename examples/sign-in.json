{
  "version": 1,
  "id": "sign-in",
  "previewData": {
    "fields": {
      "eyebrow": "Welcome back",
      "title": "Sign in to your workspace",
      "body": "Continue with your work email to access your projects."
    }
  },
  "name": "Sign in",
  "kind": "component",
  "fields": [
    {
      "name": "eyebrow",
      "type": "text"
    },
    {
      "name": "title",
      "type": "text"
    },
    {
      "name": "body",
      "type": "text"
    }
  ],
  "tokenInterface": {
    "reads": [
      "color.accent.default",
      "color.bg.canvas",
      "color.border.default",
      "color.text.primary",
      "color.text.secondary",
      "radius.lg",
      "shadow.md",
      "space.0",
      "space.gap.md",
      "space.inset.lg",
      "type.body",
      "type.caption",
      "type.title"
    ],
    "sets": {
      "input.color.border": "{color.accent.default}"
    }
  },
  "styles": {
    "declarations": {
      "background": "{color.bg}",
      "border": "1px solid {color.border}",
      "borderRadius": "{shape.radius}",
      "boxShadow": "{elevation.shadow}"
    },
    "children": {
      "body": {
        "declarations": {
          "color": "{color.text.secondary}",
          "font": "{type.body}",
          "margin": "{space.0}"
        }
      },
      "eyebrow": {
        "declarations": {
          "color": "{color.accent.default}",
          "font": "{type.caption}",
          "letterSpacing": "0.16em",
          "margin": "{space.0}",
          "textTransform": "uppercase"
        }
      },
      "title": {
        "declarations": {
          "color": "{color.text.primary}",
          "font": "{type.title}",
          "margin": "{space.0}"
        }
      }
    }
  },
  "root": {
    "id": "root",
    "type": "frame",
    "tag": "article",
    "layout": {
      "direction": "column",
      "align": "stretch",
      "gap": "{layout.gap}",
      "padding": "{layout.padding}",
      "width": {
        "mode": "fill"
      },
      "height": {
        "mode": "hug"
      }
    },
    "children": [
      {
        "id": "eyebrow",
        "type": "text",
        "tag": "p",
        "bindings": [
          {
            "field": "eyebrow",
            "target": "text"
          }
        ]
      },
      {
        "id": "title",
        "type": "text",
        "tag": "h2",
        "bindings": [
          {
            "field": "title",
            "target": "text"
          }
        ]
      },
      {
        "id": "body",
        "type": "text",
        "tag": "p",
        "bindings": [
          {
            "field": "body",
            "target": "text"
          }
        ]
      },
      {
        "id": "email",
        "type": "instance",
        "component": "input",
        "fields": {
          "label": "Work email",
          "value": "ada@atelier.test",
          "name": "work-email"
        }
      },
      {
        "id": "continue",
        "type": "instance",
        "component": "button",
        "fields": {
          "label": "Continue"
        },
        "variants": {
          "tone": "primary",
          "size": "sm"
        }
      }
    ]
  },
  "componentTokens": {
    "layout.padding": {
      "type": "dimension",
      "value": "{space.inset.lg}"
    },
    "layout.gap": {
      "type": "dimension",
      "value": "{space.gap.md}"
    },
    "shape.radius": {
      "type": "dimension",
      "value": "{radius.lg}"
    },
    "elevation.shadow": {
      "type": "shadow",
      "value": "{shadow.md}"
    },
    "color.bg": {
      "type": "color",
      "value": "{color.bg.canvas}"
    },
    "color.border": {
      "type": "color",
      "value": "{color.border.default}"
    }
  }
}
