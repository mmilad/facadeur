{
  "version": 1,
  "id": "product-card",
  "name": "Product Card",
  "kind": "component",
  "fields": [
    { "name": "title", "type": "text" },
    { "name": "price", "type": "text" },
    { "name": "imageSrc", "type": "image" },
    { "name": "imageAlt", "type": "text" },
    { "name": "buttonLabel", "type": "text" }
  ],
  "previewData": {
    "fields": {
      "title": "Everyday ceramic mug",
      "price": "€24.00",
      "imageSrc": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 720 540'%3E%3Crect width='720' height='540' fill='%23eee8df'/%3E%3Cellipse cx='360' cy='430' rx='170' ry='24' fill='%23d7cec0'/%3E%3Cpath d='M450 210h42a60 60 0 0 1 0 120h-42' fill='none' stroke='%23758674' stroke-width='28'/%3E%3Cpath d='M245 185h220v170a65 65 0 0 1-65 65h-90a65 65 0 0 1-65-65z' fill='%238b9d88'/%3E%3Cellipse cx='355' cy='185' rx='110' ry='24' fill='%23687965'/%3E%3Cellipse cx='355' cy='185' rx='90' ry='14' fill='%233f4c3e'/%3E%3C/svg%3E",
      "imageAlt": "Sage green ceramic mug on a warm neutral background",
      "buttonLabel": "Add to bag"
    }
  },
  "variants": [
    { "name": "default" },
    {
      "name": "compact",
      "overrides": {
        "nodes": {
          "image": { "layout": { "height": { "mode": "fixed", "size": 160 } } },
          "content": { "layout": { "gap": "{space.gap.sm}", "padding": "{space.inset.md}" } }
        }
      }
    }
  ],
  "variantLabels": { "default": "Default", "compact": "Compact" },
  "tokenInterface": {
    "reads": [
      "color.bg.canvas",
      "color.border.default",
      "color.text.primary",
      "color.text.secondary",
      "radius.lg",
      "shadow.md",
      "space.0",
      "space.gap.md",
      "space.gap.sm",
      "space.inset.lg",
      "space.inset.md",
      "type.body",
      "type.title"
    ]
  },
  "styles": {
    "declarations": {
      "background": "{color.bg.canvas}",
      "border": "1px solid {color.border.default}",
      "borderRadius": "{radius.lg}",
      "boxShadow": "{shadow.md}",
      "overflow": "hidden",
      "boxSizing": "border-box"
    },
    "children": {
      "image": { "declarations": { "display": "block", "objectFit": "cover" } },
      "title": {
        "declarations": {
          "color": "{color.text.primary}",
          "font": "{type.title}",
          "margin": "{space.0}",
          "overflowWrap": "anywhere"
        }
      },
      "price": {
        "declarations": {
          "color": "{color.text.secondary}",
          "font": "{type.body}",
          "margin": "{space.0}"
        }
      }
    }
  },
  "root": {
    "id": "root",
    "type": "frame",
    "tag": "article",
    "layout": {
      "direction": "column",
      "align": "stretch",
      "width": { "mode": "fill", "max": 360 },
      "height": { "mode": "hug" }
    },
    "children": [
      {
        "id": "image",
        "type": "image",
        "tag": "img",
        "layout": { "width": { "mode": "fill" }, "height": { "mode": "fixed", "size": 240 } },
        "bindings": [
          { "field": "imageSrc", "target": "src" },
          { "field": "imageAlt", "target": "alt" }
        ]
      },
      {
        "id": "content",
        "type": "frame",
        "tag": "div",
        "layout": {
          "direction": "column",
          "align": "stretch",
          "gap": "{space.gap.md}",
          "padding": "{space.inset.lg}",
          "height": { "mode": "hug" }
        },
        "children": [
          {
            "id": "title",
            "type": "text",
            "tag": "h2",
            "bindings": [{ "field": "title", "target": "text" }]
          },
          {
            "id": "price",
            "type": "text",
            "tag": "p",
            "bindings": [{ "field": "price", "target": "text" }]
          },
          {
            "id": "button",
            "type": "instance",
            "component": "button",
            "fieldBindings": { "label": "buttonLabel" },
            "layout": { "width": { "mode": "fill" }, "height": { "mode": "hug" } }
          }
        ]
      }
    ]
  }
}
