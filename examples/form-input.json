{
  "version": 1,
  "id": "form-input",
  "name": "Input",
  "kind": "atom",
  "root": {
    "id": "root",
    "name": "Input",
    "tag": "input",
    "attributes": {
      "autocomplete": "off",
      "type": "text"
    },
    "layout": {
      "width": {
        "mode": "fill"
      },
      "height": {
        "mode": "hug"
      }
    },
    "bindings": [
      {
        "field": "value",
        "target": "attribute",
        "name": "value"
      },
      {
        "field": "placeholder",
        "target": "attribute",
        "name": "placeholder"
      },
      {
        "field": "name",
        "target": "attribute",
        "name": "name"
      },
      {
        "field": "disabled",
        "target": "attribute",
        "name": "disabled"
      }
    ],
    "eventBindings": [
      {
        "event": "commit",
        "name": "change"
      }
    ],
    "type": "frame"
  },
  "fields": [
    {
      "name": "value",
      "type": "text"
    },
    {
      "name": "placeholder",
      "type": "text"
    },
    {
      "name": "name",
      "type": "text"
    },
    {
      "name": "disabled",
      "type": "boolean"
    }
  ],
  "previewData": {
    "fields": {
      "value": "",
      "placeholder": "Enter a valueasdasdasd",
      "name": "example-input",
      "disabled": false
    }
  },
  "events": [
    {
      "name": "commit",
      "payload": {
        "value": "text"
      }
    }
  ],
  "styles": {
    "declarations": {
      "appearance": "none",
      "background": "{color.surfa}",
      "border": "1px solid {color.border}",
      "borderRadius": "{shape.radius}",
      "boxSizing": "border-box",
      "color": "{color.text}",
      "font": "{type.body}",
      "paddingBlock": "{input.padding.y}",
      "paddingInline": "{input.padding.x}",
      "width": "100%"
    },
    "states": {
      "focus-visible": {
        "borderColor": "{color.accent.default}",
        "outline": "2px solid {color.accent.default}",
        "outlineOffset": "1px"
      },
      "disabled": {
        "opacity": "0.55"
      }
    }
  },
  "tokenInterface": {
    "reads": [
      "color.accent.default",
      "color.neutral.0",
      "color.neutral.400",
      "color.text.primary",
      "input.padding.x",
      "input.padding.y",
      "radius.sm",
      "type.body"
    ]
  },
  "componentTokens": {
    "n_4eopchjeve": {
      "path": "color.border",
      "type": "color",
      "value": "{color.neutral.400}",
      "label": "Borderxxxx"
    },
    "n_dwafwrelsc": {
      "path": "color.surfa",
      "type": "color",
      "value": "{color.neutral.0}",
      "label": "Surdddtttface"
    },
    "n_snilkgkaph": {
      "path": "color.text",
      "type": "color",
      "value": "{color.text.primary}"
    },
    "n_so7hlqkqdl": {
      "path": "shape.radius",
      "type": "dimension",
      "value": "{radius.sm}"
    }
  },
  "group": "form"
}
