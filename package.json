{
  "name": "facadeur",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "pnpm --filter @facadeur/server dev",
    "dev:editor": "pnpm --filter @facadeur/editor dev",
    "build": "pnpm --filter @facadeur/editor build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:uuid-uniqueness": "node scripts/check-uuid-uniqueness.mjs",
    "test": "vitest run --passWithNoTests",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "schema": "tsx scripts/export-schema.ts",
    "codegen": "echo \"codegen disabled until new catalog examples exist\" && exit 1",
    "storybook": "pnpm --filter @facadeur/editor storybook"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "eslint": "^9.36.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
