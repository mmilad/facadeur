{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mmilad/facadeur/schema/node.schema.json",
  "title": "Facadeur document",
  "description": "A facadeur page, a single node, or a component catalog. JSON data only: no functions and no events.",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/node" },
    { "$ref": "#/$defs/catalog" }
  ],
  "$defs": {
    "page": {
      "title": "Page",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "artboard": { "$ref": "#/$defs/artboard" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "artboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "node": {
      "title": "Node",
      "description": "Either an element (tagName / text / attributes / children) or a component instance (type / props / variants).",
      "oneOf": [
        { "$ref": "#/$defs/element" },
        { "$ref": "#/$defs/component" }
      ]
    },
    "element": {
      "title": "Element",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tagName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
        },
        "text": { "type": "string" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "component": {
      "title": "Component instance",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "props": { "$ref": "#/$defs/props" },
        "variants": { "$ref": "#/$defs/variants" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "catalog": {
      "title": "Component catalog",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/componentDefinition" }
    },
    "componentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template"],
      "properties": {
        "defaults": { "$ref": "#/$defs/props" },
        "template": { "$ref": "#/$defs/element" }
      }
    },
    "props": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    }
  }
}
