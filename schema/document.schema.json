                      }
                    ]
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  }
                }
              }
            },
            "style": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "type": "string"
                }
              }
            },
            "type": {
              "const": "image",
              "type": "string"
            },
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": ["id", "type", "component"],
          "properties": {
            "id": {
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "layout": {
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "position": {
                  "anyOf": [
                    {
                      "const": "auto",
                      "type": "string"
                    },
                    {
                      "const": "absolute",
                      "type": "string"
                    }
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "height": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              }
            },
            "type": {
              "const": "instance",
              "type": "string"
            },
            "component": {
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "type": "string"
            },
            "fields": {
              "type": "object",
              "patternProperties": {
                "^[A-Za-z][A-Za-z0-9_-]*$": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              }
            },
            "variants": {
              "type": "object",
              "patternProperties": {
                "^[A-Za-z][A-Za-z0-9_-]*$": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "facadeurExtension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": ["primitive", "semantic", "component"]
        },
        "breakpoints": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      }
    },
    "tokenExtensions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      },
      "properties": {
        "facadeur": {
          "$ref": "#/$defs/facadeurExtension"
        }
      }
    },
    "dtcgNode": {
      "type": "object",
      "additionalProperties": false,
      "description": "DTCG group or token. $value makes an object a token. Group $type is inherited. Child names match [a-z0-9]+.",
      "properties": {
        "$value": {
          "$ref": "#/$defs/jsonValue"
        },
        "$type": {
          "enum": [
            "color",
            "dimension",
            "number",
            "fontFamily",
            "fontWeight",
            "shadow",
            "typography"
          ]
        },
        "$description": {
          "type": "string"
        },
        "$deprecated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "$extensions": {
          "$ref": "#/$defs/tokenExtensions"
        }
      },
      "patternProperties": {
        "^[a-z0-9]+$": {
          "$ref": "#/$defs/dtcgNode"
        }
      }
    }
  }
}
